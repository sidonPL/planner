  attachments   String?
  rawIcal       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  integration   CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
}

model GeofenceZone {
  id          String          @id @default(cuid())
  householdId String
  name        String
  latitude    Float
  longitude   Float
  radius      Int
  type        String
  color       String?
  icon        String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  events      GeofenceEvent[]
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model GeofenceEvent {
  id        String       @id @default(cuid())
  zoneId    String
  userId    String
  type      String
  latitude  Float?
  longitude Float?
  timestamp DateTime     @default(now())
  user      User         @relation("UserGeofenceEvents", fields: [userId], references: [id], onDelete: Cascade)
  zone      GeofenceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([zoneId, timestamp])
}

model HouseholdAchievement {
  id            String    @id @default(cuid())
  householdId   String
  achievementId String
  name          String
  description   String
  icon          String
  points        Int
  earnedAt      DateTime  @default(now())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, earnedAt])
  @@index([achievementId])
}

model WeeklyChallenge {
  id           String                @id @default(cuid())
  householdId  String
  title        String
  description  String
  type         ChallengeType
  target       Int
  reward       Int
  icon         String
  weekStart    DateTime
  weekEnd      DateTime
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  participants ChallengParticipant[]
  household    Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, weekStart])
  @@index([isActive])
}

model ChallengParticipant {
  id            String          @id @default(cuid())
  challengeId   String
  userId        String
  progress      Int             @default(0)
  completed     Boolean         @default(false)
  completedAt   DateTime?
  rewardClaimed Boolean         @default(false)
  joinedAt      DateTime        @default(now())
  challenge     WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([challengeId, completed])
}

model InventoryHistory {
  id              String    @id @default(cuid())
  inventoryItemId String
  itemName        String
  action          String
  quantityBefore  Float?
  quantityAfter   Float?
  quantityChange  Float?
  unit            String?
  source          String?
  userId          String?
  householdId     String
  notes           String?
  timestamp       DateTime  @default(now())
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([householdId])
  @@index([timestamp])
  @@index([action])
}

model DailyLoginReward {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  loginDate   DateTime  @default(now())
  dayNumber   Int
  xpRewarded  Int
  bonusType   String?
  claimed     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, loginDate])
  @@index([userId])
  @@index([householdId])
  @@index([loginDate])
}

model LeaderboardSnapshot {
  id          String            @id @default(cuid())
  userId      String
  householdId String
  period      LeaderboardPeriod
  weekNumber  Int?
  monthNumber Int?
  year        Int
  xpEarned    Int
  rank        Int
  createdAt   DateTime          @default(now())
  Household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  User        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, weekNumber, monthNumber, year])
  @@index([householdId, period, monthNumber, year])
  @@index([householdId, period, weekNumber, year])
  @@index([period, rank])
}

model TripExpenseSplit {
  id          String      @id
  expense_id  String
  user_id     String
  amount      Float
  is_paid     Boolean     @default(false)
  paid_at     DateTime?
  created_at  DateTime    @default(now())
  TripExpense TripExpense @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@unique([expense_id, user_id])
  @@index([expense_id])
  @@index([user_id])
}

model TripSettlement {
  id           String    @id
  trip_id      String
  from_user_id String
  to_user_id   String
  amount       Float
  currency     String    @default("PLN")
  is_paid      Boolean   @default(false)
  paid_at      DateTime?
  notes        String?
  created_at   DateTime  @default(now())

  @@index([from_user_id])
  @@index([to_user_id])
  @@index([trip_id])
}

