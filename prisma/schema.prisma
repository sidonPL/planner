generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id                      String                   @id @default(cuid())
  name                    String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  inviteCode              String?                  @unique
  ownerId                 String?
  anniversaries           Anniversary[]
  auditLogs               AuditLog[]
  boardNotes              BoardNote[]
  budgets                 Budget[]
  categories              Category[]
  dailyLoginRewards       DailyLoginReward[]
  dailyQuests             DailyQuest[]
  events                  Event[]
  externalBirthdays       ExternalBirthday[]
  financialAccounts       FinancialAccount[]
  geofenceZones           GeofenceZone[]
  globalIngredients       GlobalIngredient[]
  owner                   User?                    @relation("HouseholdOwner", fields: [ownerId], references: [id])
  householdAchievements   HouseholdAchievement[]
  ingredientSubstitutions IngredientSubstitution[]
  inventoryHistory        InventoryHistory[]
  inventoryItems          InventoryItem[]
  LeaderboardSnapshot     LeaderboardSnapshot[]
  meals                   Meal[]
  notifications           Notification[]
  paymentReminders        PaymentReminder[]
  recipes                 Recipe[]
  recipeCollections       RecipeCollection[]
  recipeUsageHistory      RecipeUsageHistory[]
  rewards                 Reward[]
  routineTemplates        RoutineTemplate[]
  scannedProducts         ScannedProduct[]
  schedules               Schedule[]
  shoppingItems           ShoppingItem[]
  simpleDishes            SimpleDish[]
  tasks                   Task[]
  taskLabels              TaskLabel[]
  taskTemplates           TaskTemplate[]
  transactions            Transaction[]
  trips                   Trip[]
  tripWishlists           TripWishlist[]
  members                 User[]
  weeklyChallenges        WeeklyChallenge[]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  name                     String?
  password                 String?
  avatar                   String?
  role                     UserRole                 @default(USER)
  color                    String                   @default("#3B82F6")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  householdId              String?
  birthDate                DateTime?
  nameDay                  String?
  lastKnownLatitude        Float?
  lastKnownLongitude       Float?
  lastLocationUpdate       DateTime?
  shareLocationWithFamily  Boolean                  @default(false)
  allergens                String[]                 @default([])
  calendarSyncToken        String?                  @unique
  currentStreak            Int                      @default(0)
  lastActivityDate         DateTime?
  level                    Int                      @default(1)
  longestStreak            Int                      @default(0)
  xp                       Int                      @default(0)
  lastLoginDate            DateTime?
  loginStreak              Int                      @default(0)
  longestLoginStreak       Int                      @default(0)
  activeTheme              String?
  activeTitle              String?
  xpBoostMultiplier        Float?                   @default(1.0)
  xpBoostExpiresAt         DateTime?
  accounts                 Account[]
  anniversaries            Anniversary[]
  auditLogs                AuditLog[]
  badgeProgress            BadgeProgress[]
  boardNotes               BoardNote[]
  readBoardNotes           BoardNoteRead[]
  calendarIntegrations     CalendarIntegration[]    @relation("UserCalendarIntegrations")
  challengeParticipations  ChallengParticipant[]
  claimedRewards           ClaimedReward[]
  addedToCollections       CollectionRecipe[]
  dailyQuestCompletions    DailyQuestCompletion[]
  events                   Event[]
  createdExternalBirthdays ExternalBirthday[]
  favoriteRecipes          FavoriteRecipe[]
  geofenceEvents           GeofenceEvent[]          @relation("UserGeofenceEvents")
  ownedHouseholds          Household[]              @relation("HouseholdOwner")
  ingredientSubstitutions  IngredientSubstitution[]
  LeaderboardSnapshot      LeaderboardSnapshot[]
  assignedMeals            Meal[]                   @relation("AssignedMeals")
  notifications            Notification[]
  nutritionGoals           NutritionGoal[]
  passwordResetTokens      PasswordResetToken[]
  pointsHistory            PointsHistory[]
  presenceRecords          Presence[]
  pushSubscriptions        PushSubscription[]
  recipes                  Recipe[]
  recipeCollections        RecipeCollection[]
  recipeComments           RecipeComment[]
  recipeNotes              RecipeNote[]
  recipeRatings            RecipeRating[]
  recipeUsageHistory       RecipeUsageHistory[]     @relation("UserRecipeUsage")
  recipeVariations         RecipeVariation[]
  routineStreaks           RoutineStreak[]          @relation("UserRoutineStreaks")
  createdRoutineTemplates  RoutineTemplate[]        @relation("CreatedRoutineTemplates")
  schedules                Schedule[]
  sessions                 Session[]
  assignedShoppingItems    ShoppingItem[]           @relation("AssignedShoppingItems")
  assignedTasks            Task[]                   @relation("AssignedTasks")
  createdTasks             Task[]                   @relation("CreatedTasks")
  taskAttachments          TaskAttachment[]         @relation("TaskAttachments")
  taskComments             TaskComment[]            @relation("TaskComments")
  completedTasks           TaskCompletion[]
  createdTemplates         TaskTemplate[]           @relation("CreatedTaskTemplates")
  taskTimeEntries          TaskTimeEntry[]          @relation("TaskTimeEntries")
  transactions             Transaction[]
  carPoolsAsDriver         TripCarPool[]            @relation("TripCarPoolDriver")
  tripMealsAssigned        TripMeal[]               @relation("TripMealAssignee")
  tripParticipants         TripParticipant[]
  tripWishlists            TripWishlist[]
  household                Household?               @relation(fields: [householdId], references: [id])
  userAchievements         UserAchievement[]
  badges                   UserBadge[]
  settings                 UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  pushEnabled           Boolean  @default(true)
  emailEnabled          Boolean  @default(false)
  ttsEnabled            Boolean  @default(false)
  quietHoursStart       String?
  quietHoursEnd         String?
  theme                 String   @default("system")
  dashboardLayout       Json?
  language              String   @default("pl")
  timezone              String   @default("Europe/Warsaw")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  defaultActiveUserId   String?
  defaultViewMode       String   @default("family")
  accentColor           String?
  dietaryPreferences    Json?
  emailReports          Boolean  @default(false)
  taskFilterPreferences Json?
  weatherApiKey         String?
  weatherCity           String?
  weatherLocationMode   String   @default("city")
  weatherLatitude       Float?
  weatherLongitude      Float?
  fontSize              String   @default("medium")
  soundEnabled          Boolean  @default(true)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id               String            @id @default(cuid())
  name             String
  color            String            @default("#6B7280")
  icon             String?
  householdId      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  type             TransactionType?
  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paymentReminders PaymentReminder[]
  tasks            Task[]
  transactions     Transaction[]

  @@unique([name, householdId])
}

model Task {
  id                      String           @id @default(cuid())
  title                   String
  description             String?
  priority                Priority         @default(MEDIUM)
  status                  TaskStatus       @default(TODO)
  dueDate                 DateTime?
  dueTime                 String?
  isRecurring             Boolean          @default(false)
  recurrenceType          RecurrenceType?
  recurrenceInterval      Int?
  recurrenceEndDate       DateTime?
  recurrenceDays          Int[]
  parentTaskId            String?
  reminderMinutes         Int[]
  isPinned                Boolean          @default(false)
  householdId             String
  categoryId              String?
  assigneeId              String?
  creatorId               String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  actualMinutes           Int?
  color                   String?
  estimatedMinutes        Int?
  position                Int              @default(0)
  startedAt               DateTime?
  subtaskParentId         String?
  recurrenceTimes         String[]
  routineStreaks          RoutineStreak[]
  assignee                User?            @relation("AssignedTasks", fields: [assigneeId], references: [id])
  category                Category?        @relation(fields: [categoryId], references: [id])
  creator                 User             @relation("CreatedTasks", fields: [creatorId], references: [id])
  household               Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parentTask              Task?            @relation("TaskRecurrence", fields: [parentTaskId], references: [id])
  childTasks              Task[]           @relation("TaskRecurrence")
  subtaskParent           Task?            @relation("TaskSubtasks", fields: [subtaskParentId], references: [id], onDelete: Cascade)
  subtasks                Task[]           @relation("TaskSubtasks")
  attachments             TaskAttachment[]
  comments                TaskComment[]
  completions             TaskCompletion[]
  timeEntries             TaskTimeEntry[]
  Task_TaskDependencies_A Task[]           @relation("TaskDependencies")
  Task_TaskDependencies_B Task[]           @relation("TaskDependencies")
  labels                  TaskLabel[]      @relation("TaskToTaskLabel")

  @@index([householdId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([householdId, status])
  @@index([householdId, assigneeId])
  @@index([householdId, dueDate])
  @@index([creatorId])
  @@index([categoryId])
  @@index([isRecurring])
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  completedAt DateTime @default(now())
  notes       String?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskComments", fields: [userId], references: [id])

  @@index([taskId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedBy String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader   User     @relation("TaskAttachments", fields: [uploadedBy], references: [id])

  @@index([taskId])
}

model TaskLabel {
  id          String    @id @default(cuid())
  name        String
  color       String
  householdId String
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks       Task[]    @relation("TaskToTaskLabel")

  @@unique([householdId, name])
  @@index([householdId])
}

model TaskTimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?
  description String?
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation("TaskTimeEntries", fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

model TaskTemplate {
  id            String             @id @default(cuid())
  name          String
  description   String?
  icon          String?
  householdId   String
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  creator       User               @relation("CreatedTaskTemplates", fields: [createdBy], references: [id])
  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  taskTemplates TaskTemplateItem[]

  @@index([householdId])
}

model TaskTemplateItem {
  id               String       @id @default(cuid())
  templateId       String
  title            String
  description      String?
  priority         Priority     @default(MEDIUM)
  estimatedMinutes Int?
  categoryId       String?
  position         Int          @default(0)
  template         TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model RoutineTemplate {
  id          String     @id @default(cuid())
  name        String
  description String?
  icon        String?
  category    String
  tasks       Json
  isPublic    Boolean    @default(true)
  householdId String?
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User?      @relation("CreatedRoutineTemplates", fields: [createdBy], references: [id])
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([category])
}

model RoutineStreak {
  id               String    @id @default(cuid())
  taskId           String
  userId           String
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  totalCompletions Int       @default(0)
  lastCompletedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user             User      @relation("UserRoutineStreaks", fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

model Event {
  id              String    @id @default(cuid())
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime?
  allDay          Boolean   @default(false)
  color           String?
  type            EventType @default(GENERAL)
  location        String?
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?
  householdId     String
  userId          String?
  linkedTripId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reminderMinutes Int[]
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id])
  trip            Trip?     @relation(fields: [linkedTripId], references: [id], onDelete: SetNull)

  @@index([linkedTripId])
}

model Anniversary {
  id          String          @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        AnniversaryType @default(OTHER)
  color       String          @default("#EC4899")
  householdId String
  userId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id])
}

model ExternalBirthday {
  id           String    @id @default(cuid())
  name         String
  birthDate    DateTime
  nameDay      String?
  relationship String?
  phone        String?
  email        String?
  notes        String?
  color        String    @default("#EC4899")
  householdId  String
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User      @relation(fields: [createdById], references: [id])
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Schedule {
  id          String              @id @default(cuid())
  name        String
  type        ScheduleType
  dayOfWeek   Int[]
  startTime   String
  endTime     String
  location    String?
  color       String?
  isActive    Boolean             @default(true)
  householdId String
  userId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  isOneTime   Boolean             @default(false)
  oneTimeDate DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  recurrenceUnit ScheduleRecurrenceUnit @default(WEEKLY)
  repeatEvery  Int                 @default(1)
  specificDates DateTime[]         @default([])
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])
  exceptions  ScheduleException[]

  @@index([householdId])
  @@index([userId])
  @@index([householdId, userId])
  @@index([type])
  @@index([isActive])
  @@index([isOneTime])
  @@index([oneTimeDate])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([recurrenceUnit])
}

model ScheduleException {
  id         String   @id @default(cuid())
  scheduleId String
  date       DateTime
  reason     String?
  createdAt  DateTime @default(now())
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model Trip {
  id              String              @id @default(cuid())
  name            String
  description     String?
  destination     String?
  startDate       DateTime
  endDate         DateTime
  status          TripStatus          @default(PLANNED)
  householdId     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  coverImage      String?
  currency        String              @default("PLN")
  notes           String?
  plannedBudget   Float?
  additionalNotes String?
  household       Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accommodations  TripAccommodation[]
  carPools        TripCarPool[]
  checklists      TripChecklist[]
  documents       TripDocument[]
  events          Event[]
  expenses        TripExpense[]
  itinerary       TripItineraryDay[]
  meals           TripMeal[]
  participants    TripParticipant[]
  places          TripPlace[]
  transports      TripTransport[]
}

model TripWishlist {
  id                String    @id @default(cuid())
  destination       String
  description       String?
  country           String?
  estimatedBudget   Float?
  currency          String    @default("PLN")
  priority          Int       @default(3)
  season            String?
  notes             String?
  imageUrl          String?
  householdId       String
  addedById         String
  interestedUserIds String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  latitude          Float?
  longitude         Float?
  address           String?
  addedBy           User      @relation(fields: [addedById], references: [id], onDelete: Cascade)
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([addedById])
}

model TripPlace {
  id                String            @id @default(cuid())
  tripId            String
  name              String
  description       String?
  category          TripPlaceCategory @default(ATTRACTION)
  address           String?
  latitude          Float?
  longitude         Float?
  isVisited         Boolean           @default(false)
  visitOrder        Int?
  visitDate         DateTime?
  visitNotes        String?
  websiteUrl        String?
  phoneNumber       String?
  openingHours      String?
  estimatedDuration Int?
  estimatedCost     Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  trip              Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripDocument {
  id         String           @id @default(cuid())
  tripId     String
  name       String
  type       TripDocumentType @default(OTHER)
  url        String?
  fileUrl    String?
  notes      String?
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime         @default(now())
  trip       Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripExpense {
  id               String             @id @default(cuid())
  tripId           String
  name             String
  amount           Float
  category         String?
  paidById         String?
  date             DateTime           @default(now())
  notes            String?
  createdAt        DateTime           @default(now())
  transactionId    String?            @unique
  currency         String             @default("PLN")
  trip             Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  TripExpenseSplit TripExpenseSplit[]
}

model TripParticipant {
  id        String  @id @default(cuid())
  tripId    String
  userId    String
  role      String?
  confirmed Boolean @default(false)
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
}

model TripChecklist {
  id        String              @id @default(cuid())
  tripId    String
  name      String
  createdAt DateTime            @default(now())
  trip      Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items     TripChecklistItem[]
}

model TripChecklistItem {
  id          String        @id @default(cuid())
  checklistId String
  name        String
  isPacked    Boolean       @default(false)
  assignedTo  String?
  createdAt   DateTime      @default(now())
  checklist   TripChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model TripItineraryDay {
  id         String                  @id @default(cuid())
  tripId     String
  date       DateTime
  title      String?
  notes      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  activities TripItineraryActivity[]
  trip       Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripItineraryActivity {
  id          String           @id @default(cuid())
  dayId       String
  time        String
  title       String
  description String?
  location    String?
  duration    Int?
  category    String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  day         TripItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model TripAccommodation {
  id         String    @id @default(cuid())
  tripId     String
  name       String
  type       String    @default("hotel")
  address    String?
  phone      String?
  checkIn    DateTime?
  checkOut   DateTime?
  roomInfo   String?
  bookingRef String?
  website    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripTransport {
  id            String    @id @default(cuid())
  tripId        String
  type          String
  name          String?
  departureFrom String?
  arrivalTo     String?
  departureTime DateTime?
  arrivalTime   DateTime?
  bookingRef    String?
  seatNumber    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripCarPool {
  id        String   @id @default(cuid())
  tripId    String
  driverId  String
  seats     Int
  route     String?
  cost      Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    User     @relation("TripCarPoolDriver", fields: [driverId], references: [id], onDelete: Cascade)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([driverId])
}

model TripMeal {
  id         String    @id @default(cuid())
  tripId     String
  date       DateTime
  mealType   String    // śniadanie, obiad, kolacja, przekąska
  recipeId   String?
  customName String?
  assignedTo String?
  notes      String?
  budget     Float?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  recipe     Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  assignee   User?     @relation("TripMealAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([date])
  @@index([recipeId])
}

model ShoppingItem {
  id           String    @id @default(cuid())
  name         String
  quantity     Float?
  unit         String?
  category     String?
  isPurchased  Boolean   @default(false)
  isUrgent     Boolean   @default(false)
  householdId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addedBy      String?
  notes        String?
