# Docker ignore file - what NOT to copy to Docker image
# This reduces build time and image size

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
build/
dist/

# Testing
coverage/
.nyc_output/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml

# Documentation (optional - comment out if you want docs in container)
docs/
*.md
!README.md

# Backups
backups/
*.sql
*.sql.gz

# Logs
logs/
*.log

# Misc
.prettierrc
.eslintrc.json
tsconfig.tsbuildinfo

