# Pusher Configuration (Real-time updates)
# Get your credentials from https://pusher.com/

# Server-side
PUSHER_APP_ID=your_app_id
PUSHER_SECRET=your_secret

# Client-side (NEXT_PUBLIC_ prefix makes it available in browser)
NEXT_PUBLIC_PUSHER_KEY=your_key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Cloudinary Configuration (Image uploads)
# Get your credentials from https://cloudinary.com/

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# How to setup:
# 1. Pusher:
#    - Sign up at https://pusher.com/
#    - Create new app
#    - Copy credentials from "App Keys" tab
#    - Replace values above
#
# 2. Cloudinary:
#    - Sign up at https://cloudinary.com/
#    - Go to Settings > Upload
#    - Create unsigned upload preset
#    - Copy cloud name and preset name
#    - Replace values above

