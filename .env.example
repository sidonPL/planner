# Database
DATABASE_URL="postgresql://user:password@localhost:5432/family_planner"

# Database Connection Pool (Optymalizacja dla VPS)
DB_POOL_MAX=10
DB_POOL_MIN=2

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-auth-secret-here"
# Legacy alias (optional): keep same value as AUTH_SECRET
NEXTAUTH_SECRET="your-auth-secret-here"

# Rate Limiting (Optymalizacja dla VPS)
RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_WINDOW=100
API_RATE_LIMIT=60

# CRON Security
CRON_SECRET="your-cron-secret-key-here"

# Shopping list: auto-delete purchased items after N hours (default 48)
SHOPPING_PURCHASED_RETENTION_HOURS=48

# Build Configuration
BUILD_STANDALONE=false

# App timezone (daily login streaks, reminders)
APP_TIMEZONE="Europe/Warsaw"


# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini AI (Optional - for smart recipe import)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=""

# Cloudinary (Optional - for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Optional - for notification emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Family Planner <noreply@example.com>"

# Push Notifications (Optional)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Sentry Error Tracking (Production)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

